# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://eloforge:eloforge@localhost:5432/eloforge
VALKEY_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Production: true, and FRONTEND_ORIGIN=https://your-domain
COOKIE_SECURE=false
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
# Caddy site address. ":80" for local HTTP; "eloforge.example.com" for automatic HTTPS.
SITE_ADDRESS=:80
WEB_PORT=3000
WEB_TLS_PORT=8443
LOG_FORMAT=pretty
RUST_LOG=info,eloforge_api=debug

# ─── Stockfish ───────────────────────────────────────────────────────────────
STOCKFISH_PATH=stockfish
STOCKFISH_WORKERS=4
STOCKFISH_HASH_MB=128
STOCKFISH_THREADS=2
STOCKFISH_TIMEOUT_MS=5000
ANALYSIS_DEPTH_FULL=14
ANALYSIS_DEPTH_CRITICAL=20
ANALYSIS_MOVETIME_FULL_MS=160
ANALYSIS_MOVETIME_CRITICAL_MS=600

# ─── OpenCode Go (backend only — never expose to the browser) ────────────────
OPENCODE_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# EloForge default model: DeepSeek V4.1 Flash (OpenAI-compatible chat protocol)
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_PROTOCOL=chat
OPENCODE_GO_TIMEOUT_SEC=90
AI_DAILY_TOKEN_BUDGET=250000

# ─── Chess.com PubAPI ────────────────────────────────────────────────────────
CHESSCOM_BASE_URL=https://api.chess.com/pub
CHESSCOM_USER_AGENT=EloForge/1.0 (contact: contact@eloforge.app)
CHESSCOM_MIN_INTERVAL_MS=200
CHESSCOM_OAUTH_ENABLED=false
CHESSCOM_OAUTH_CLIENT_ID=
CHESSCOM_OAUTH_CLIENT_SECRET=
CHESSCOM_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/chesscom/callback

# ─── Notifications (all optional) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=coach@eloforge.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@eloforge.app

# ─── Ops ─────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
SYNC_MAX_ARCHIVES=120
BACKUP_RETENTION_DAYS=14
